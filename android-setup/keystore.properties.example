# Keystore Configuration
# 
# Why: This file stores your app signing credentials securely.
# 
# Instructions:
# 1. Copy this file to android/keystore.properties
# 2. Fill in your actual values
# 3. DO NOT commit keystore.properties to git (it's in .gitignore)
# 4. Keep keystore file and passwords secure

# Path to keystore file (relative to android/ folder)
storeFile=../app/flipdrag-release.keystore

# Keystore password (from keytool command)
storePassword=your_keystore_password_here

# Key alias (from keytool command)
keyAlias=flipdrag

# Key password (usually same as storePassword)
keyPassword=your_key_password_here

# Security Notes:
# - Store passwords in a password manager
# - Backup keystore file securely (cloud + local)
# - Never share keystore or passwords
# - If lost, you cannot update your app on Play Store!


